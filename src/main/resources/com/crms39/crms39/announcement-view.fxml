<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.crms39.crms39.controller.AnnouncementController">

    <top>
        <VBox alignment="CENTER" spacing="8.0">
            <padding>
                <Insets top="20.0" right="20.0"
                        bottom="15.0" left="20.0"/>
            </padding>

            <Label text="Class Announcements"
                   style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

            <Label text="All users can view announcements."/>
        </VBox>
    </top>

    <center>
        <ListView fx:id="announcementListView"
                  prefWidth="500.0"
                  prefHeight="350.0">
            <BorderPane.margin>
                <Insets top="10.0" right="20.0"
                        bottom="10.0" left="20.0"/>
            </BorderPane.margin>
        </ListView>
    </center>

    <right>
        <VBox fx:id="postAnnouncementBox"
              spacing="10.0"
              prefWidth="280.0">
            <padding>
                <Insets top="10.0" right="20.0"
                        bottom="10.0" left="10.0"/>
            </padding>

            <Label text="Post Announcement"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <TextField fx:id="titleField"
                       promptText="Announcement title"/>

            <TextArea fx:id="messageArea"
                      promptText="Write your announcement here"
                      wrapText="true"
                      prefRowCount="6"/>

            <Button text="Post Announcement"
                    onAction="#handlePostAnnouncement"
                    maxWidth="Infinity"/>
            <Button text="Delete Selected Announcement"
                    onAction="#handleDeleteAnnouncement"
                    maxWidth="Infinity"
                    style="-fx-text-fill: #b00020;"/>
        </VBox>
    </right>

    <bottom>
        <VBox alignment="CENTER" spacing="10.0">
            <padding>
                <Insets top="10.0" right="20.0"
                        bottom="20.0" left="20.0"/>
            </padding>

            <Label fx:id="statusLabel"
                   wrapText="true"/>

            <Button fx:id="backButton"
                    text="Back to Dashboard"
                    onAction="#handleBackToDashboard"
                    maxWidth="200.0"/>
        </VBox>
    </bottom>

</BorderPane>