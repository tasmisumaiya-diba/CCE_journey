<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER"
      spacing="12.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.crms39.crms39.controller.DashboardController">

    <padding>
        <Insets top="40.0" right="40.0" bottom="40.0" left="40.0"/>
    </padding>

    <Label text="CRMS Dashboard"
           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <Label fx:id="welcomeLabel"
           style="-fx-font-size: 18px;"/>

    <Label fx:id="roleLabel"/>

    <Label fx:id="permissionLabel"
           wrapText="true"
           maxWidth="350.0"/>

    <Button fx:id="viewRoutineButton"
            text="View Routine"
            onAction="#handleViewRoutine"
            maxWidth="250.0"/>

    <Button fx:id="viewAnnouncementsButton"
            text="View Announcements"
            onAction="#handleViewAnnouncements"
            maxWidth="250.0"/>

    <Button fx:id="manageRoutineButton"
            text="Manage Routine"
            onAction="#handleManageRoutine"
            maxWidth="250.0"/>

    <Button fx:id="bookClassroomButton"
            text="Book Classroom"
            onAction="#handleBookClassroom"
            maxWidth="250.0"/>

    <Button fx:id="postAnnouncementButton"
            text="Post Announcement"
            onAction="#handleViewAnnouncements"
            maxWidth="250.0"/>

    <Button fx:id="logoutButton"
            text="Log Out"
            onAction="#handleLogout"
            maxWidth="250.0"
            style="-fx-text-fill: #b00020;"/>

</VBox>