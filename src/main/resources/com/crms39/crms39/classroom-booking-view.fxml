<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.crms39.crms39.controller.ClassroomBookingController">

    <top>
        <VBox alignment="CENTER" spacing="8.0">
            <padding>
                <Insets top="20.0" right="20.0"
                        bottom="15.0" left="20.0"/>
            </padding>

            <Label text="Classroom Booking"
                   style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

            <Label text="Teacher and CR access only"/>
        </VBox>
    </top>

    <center>
        <TableView fx:id="bookingTable">
            <columns>
                <TableColumn fx:id="roomColumn"
                             text="Room"
                             prefWidth="90.0"/>

                <TableColumn fx:id="dayColumn"
                             text="Day"
                             prefWidth="100.0"/>

                <TableColumn fx:id="startTimeColumn"
                             text="Start"
                             prefWidth="75.0"/>

                <TableColumn fx:id="endTimeColumn"
                             text="End"
                             prefWidth="75.0"/>

                <TableColumn fx:id="purposeColumn"
                             text="Purpose"
                             prefWidth="220.0"/>

                <TableColumn fx:id="bookedByColumn"
                             text="Booked By"
                             prefWidth="150.0"/>
            </columns>

            <BorderPane.margin>
                <Insets top="5.0" right="10.0"
                        bottom="5.0" left="20.0"/>
            </BorderPane.margin>
        </TableView>
    </center>

    <right>
        <VBox spacing="8.0" prefWidth="250.0">
            <padding>
                <Insets top="5.0" right="20.0"
                        bottom="5.0" left="10.0"/>
            </padding>

            <Label text="New Room Booking"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <Label text="Room code"/>
            <TextField fx:id="roomField"
                       promptText="Example: CR-302"/>

            <Label text="Day"/>
            <TextField fx:id="dayField"
                       promptText="Example: Sunday"/>

            <Label text="Start time"/>
            <TextField fx:id="startTimeField"
                       promptText="Example: 14:15"/>

            <Label text="End time"/>
            <TextField fx:id="endTimeField"
                       promptText="Example: 15:10"/>

            <Label text="Purpose"/>
            <TextField fx:id="purposeField"
                       promptText="Example: Extra CIT-121 class"/>

            <Button text="Book Classroom"
                    onAction="#handleBookClassroom"
                    maxWidth="Infinity"/>

            <Button text="Cancel Selected Booking"
                    onAction="#handleCancelBooking"
                    maxWidth="Infinity"
                    style="-fx-text-fill: #b00020;"/>

            <Label fx:id="statusLabel"
                   wrapText="true"/>
        </VBox>
    </right>

    <bottom>
        <HBox alignment="CENTER">
            <padding>
                <Insets top="10.0" right="20.0"
                        bottom="15.0" left="20.0"/>
            </padding>

            <Button fx:id="backButton"
                    text="Back to Dashboard"
                    onAction="#handleBackToDashboard"
                    maxWidth="200.0"/>
        </HBox>
    </bottom>

</BorderPane>